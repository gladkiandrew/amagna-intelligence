{
  "name": "amagna-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "A reference architecture for running an AI-native operation: markdown memory, chartered agents, and a Telegram cockpit on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/deal-screener"
  ],
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "screen": "tsx examples/deal-screener/src/cli.ts",
    "pipeline": "tsx examples/deal-screener/src/pipeline-cli.ts",
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
