# Copy to .env.local (gitignored) if you want to run against a real model.
# Everything in this repo works with NONE of these set — `npm run demo` and
# `npm test` are keyless by design.

# ------------------------------------------------------------------ the model
# Any model works. Pick ONE provider; nothing is Anthropic-specific.
#
#   LLM_PROVIDER   anthropic | openai | xai | openrouter | ollama | openai-compatible | command | mock
#   LLM_MODEL      the provider's model name (required for every provider except anthropic/command)
#
# Examples:
#   LLM_PROVIDER=anthropic          ANTHROPIC_API_KEY=…   (LLM_MODEL defaults to claude-opus-5)
#   LLM_PROVIDER=openai             OPENAI_API_KEY=…      LLM_MODEL=…
#   LLM_PROVIDER=xai                XAI_API_KEY=…         LLM_MODEL=…   (Grok)
#   LLM_PROVIDER=openrouter         OPENROUTER_API_KEY=…  LLM_MODEL=…
#   LLM_PROVIDER=ollama             LLM_MODEL=llama3.1    (local open-weight, no key)
#   LLM_PROVIDER=openai-compatible  LLM_BASE_URL=http://localhost:8000/v1  LLM_MODEL=…  (vLLM, LM Studio, …)
#   LLM_PROVIDER=command            LLM_COMMAND="claude -p"   (a subscription CLI such as Claude
#                                                            Code on a Claude plan — no API key)
#
# Nothing set = mock transport with fixtures. For backwards compatibility an
# Anthropic credential with no LLM_PROVIDER still selects Anthropic.
LLM_PROVIDER=
LLM_MODEL=
# LLM_API_KEY=        # used by openai-compatible when the server needs one
# LLM_BASE_URL=       # overrides a preset's endpoint, or required for openai-compatible
# LLM_COMMAND=        # used by command

# Force mock mode even when a credential is present. Useful in CI.
# MOCK=1

# ------------------------------------------------------------ write-scope guard
# Path to the scope table the PreToolUse hook reads.
# AMAGNA_SCOPE_TABLE=./write-scopes.json

# --------------------------------------------------- Workers (set via wrangler)
# These are NOT read from a .env file in production. Each Worker reads them from
# its own environment: `wrangler secret put <NAME>` for secrets, `vars` in
# wrangler.jsonc for non-secrets. Listed here so the full surface is visible.
#
# vault-bridge:
#   BRIDGE_TOKEN      long random hex; Bearer token on every route
#   GITHUB_TOKEN      fine-grained PAT, contents:write on ONE repo
#   GITHUB_REPO       owner/repo of the markdown vault          (var)
#   GITHUB_BRANCH     branch to commit to                       (var)
#   NOTES_DIR         directory new notes land in               (var)
#
# cockpit-worker:
#   TELEGRAM_BOT_TOKEN       from BotFather
#   TELEGRAM_WEBHOOK_SECRET  the secret_token passed to setWebhook
#   BRIDGE_TOKEN             must match the vault-bridge token
#   ALLOWED_CHAT_IDS         comma-separated; empty denies everyone  (var)
#   BRIDGE_URL               your vault-bridge deployment            (var)
