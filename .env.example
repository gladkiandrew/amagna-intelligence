# Copy to .env.local (gitignored) if you want to run against a real model.
# Everything in this repo works with NONE of these set — `npm run demo` and
# `npm test` are keyless by design.

# ----------------------------------------------------------------- Anthropic
# Present = agent runs call the real API. Absent = mock transport with fixtures.
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile, so an
# unset key does not necessarily mean "no credentials".
ANTHROPIC_API_KEY=sk-ant-replace-me

# Override the default model (claude-opus-5). Optional.
# ANTHROPIC_MODEL=claude-opus-5

# Force mock mode even when a credential is present. Useful in CI.
# MOCK=1

# ------------------------------------------------------------ write-scope guard
# Path to the scope table the PreToolUse hook reads.
# AMAGNA_SCOPE_TABLE=./write-scopes.json

# --------------------------------------------------- Workers (set via wrangler)
# These are NOT read from a .env file in production. Each Worker reads them from
# its own environment: `wrangler secret put <NAME>` for secrets, `vars` in
# wrangler.jsonc for non-secrets. Listed here so the full surface is visible.
#
# vault-bridge:
#   BRIDGE_TOKEN      long random hex; Bearer token on every route
#   GITHUB_TOKEN      fine-grained PAT, contents:write on ONE repo
#   GITHUB_REPO       owner/repo of the markdown vault          (var)
#   GITHUB_BRANCH     branch to commit to                       (var)
#   NOTES_DIR         directory new notes land in               (var)
#
# cockpit-worker:
#   TELEGRAM_BOT_TOKEN       from BotFather
#   TELEGRAM_WEBHOOK_SECRET  the secret_token passed to setWebhook
#   BRIDGE_TOKEN             must match the vault-bridge token
#   ALLOWED_CHAT_IDS         comma-separated; empty denies everyone  (var)
#   BRIDGE_URL               your vault-bridge deployment            (var)
